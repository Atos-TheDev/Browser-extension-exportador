{
  "manifest_version": 3,
  "name": "Digisac para Exportador",
  "version": "1.1.0",
  "description": "Captura sessão Digisac sob demanda e acompanha jobs AWX iniciados pela ferramenta.",
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://*.digisac.me/*",
    "https://*.digisac.app/*",
    "https://*.digisac.co/*",
    "https://*.digisac.chat/*",
    "https://*.digisac.io/*",
    "https://*.digisac.biz/*",
    "https://exportador-digisac.atos-prado.workers.dev/*",
    "https://awx-public.ikatec.cloud/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capturar token Digisac",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://exportador-digisac.atos-prado.workers.dev/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://awx-public.ikatec.cloud/*"
      ],
      "js": [
        "awx-autofill.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
