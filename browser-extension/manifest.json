{
  "manifest_version": 3,
  "name": "Digisac para Exportador",
  "version": "1.0.0",
  "description": "Envia ao Exportador a URL e o bearer token da próxima requisição Digisac, somente após acionamento manual.",
  "permissions": [
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.digisac.me/*",
    "https://*.digisac.app/*",
    "https://*.digisac.co/*",
    "https://*.digisac.chat/*",
    "https://*.digisac.io/*",
    "https://exportador-digisac.atos-prado.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capturar token Digisac",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://exportador-digisac.atos-prado.workers.dev/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
